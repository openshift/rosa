FROM registry.access.redhat.com/ubi10/go-toolset:1.27.4-1795507689 AS builder
WORKDIR /rosa
USER root
COPY . .

RUN dnf install -y --setopt=install_weak_deps=False --nodocs wget tar python3-pip unzip zip && \
    pip3 install --target=/awscli awscli && \
    dnf clean all

RUN wget  https://mirror.openshift.com/pub/openshift-v4/x86_64/clients/ocp/stable/openshift-client-linux-amd64-rhel9.tar.gz && \
    tar -xvf openshift-client-linux-amd64-rhel9.tar.gz && \
    mv oc /usr/local/bin && \
    which oc

# Pin the module cache path that the runtime stage copies from, instead of relying
# on the go-toolset default ($HOME/go/pkg/mod).
ENV GOMODCACHE=/opt/app-root/src/go/pkg/mod
RUN go install github.com/onsi/ginkgo/v2/ginkgo@v2.13.2
RUN go env -w GOFLAGS=-buildvcs=false
RUN make release
# Download the full module graph (including test-only modules such as Ginkgo and
# Gomega) so the runtime image can compile ./tests/e2e without network access.
RUN GOTOOLCHAIN=auto go mod download

# Keep the runtime on the same RHEL major as the builder above: this stage reuses the
# builder's Python tree (/awscli, installed with the builder's pip) and its Go toolchain,
# so a RHEL 9 runtime under a RHEL 10 builder breaks `aws` (awscli >= 1.46 needs Python
# >= 3.10, UBI 9 ships Python 3.9).
FROM registry.access.redhat.com/ubi10/ubi:latest
WORKDIR /rosa
RUN mkdir /rosa/tests

COPY --from=builder /rosa/ /rosa/
COPY --from=builder /usr/lib/golang/ /usr/lib/golang/
COPY --from=builder /opt/app-root/src/go/pkg/mod/ /opt/app-root/src/go/pkg/mod/
COPY --from=builder /usr/local/bin/oc /usr/local/bin/oc
COPY --from=builder /opt/app-root/src/go/bin/ginkgo /usr/local/bin/ginkgo
COPY --from=builder /awscli /awscli
COPY --from=builder /awscli/bin/aws /usr/local/bin/aws
COPY --from=builder /usr/bin/unzip /usr/local/bin/unzip

RUN unzip releases/rosa_linux_amd64.zip
RUN mv /rosa/rosa /usr/local/bin/rosa

ENV PYTHONPATH=/awscli
ENV PATH="/usr/lib/golang/bin:${PATH}"
ENV GOMODCACHE=/opt/app-root/src/go/pkg/mod


CMD ["/bin/bash"]